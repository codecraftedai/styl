# Copy to .env.local (never commit .env.local). All three are free.
# Without the Supabase pair the app runs in demo mode (data stays in the browser).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq → console.groq.com/keys (free, no card). Main provider for photo check + auto-fill (fast).
GROQ_API_KEY=
# Optional: GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google AI Studio → Get API key (free tier). Backup provider if Groq fails.
GEMINI_API_KEY=
# Optional: override the model if Google renames it
# GEMINI_MODEL=gemini-2.5-flash
