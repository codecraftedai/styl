# Copy to .env.local (never commit .env.local). All three are free.
# Without the Supabase pair the app runs in demo mode (data stays in the browser).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key (free tier). Enables photo checks + auto-fill.
GEMINI_API_KEY=
# Optional: override the model if Google renames it
# GEMINI_MODEL=gemini-2.5-flash
